using RUB = unsigned long int;

bool life = true;
int month = 1;
int year = 2026;

const int end_month = 7;
const int end_year = 2036;

struct Person{

RUB money = 10'000;
RUB safety_pillow = 50'000;

RUB bank_money = 0;

RUB salary = 30'000;
bool salary_b = true;

RUB spents = 0;

RUB spents_food = 20'000;
bool spents_food_b = true;
};
Person I;

void me_money_profit(Person& person, const RUB profit)            // Изменение бюджета
{
    person.money += profit;
}

void check_money(Person& person, const RUB cost)
{
    if (cost > person.money){
        if (cost <= person.money + person.bank_money){
            RUB transfer = cost - person.money;
            person.bank_money -= transfer;
            person.money += transfer;
        }
        if (cost > person.money + person.bank_money){
        }
    }
}

void me_salary(Person& person)                            // Зарплата
{
    if (person.salary_b){
       me_money_profit(person, person.salary); 
    }
}

void me_shopping(Person& person)                          // Траты на еду
{
    RUB cost = 0;
    if (person.spents_food_b){
        cost += person.spents_food;
    }
    check_money(person, cost);
    me_money_profit(person, -cost); 
}

void me_cost_save(Person& person, RUB cost)                 // Сбережения
{
    if (cost > person.safety_pillow){
        RUB transfer = person.money - person.safety_pillow;
        person.bank_money += transfer;
        person.money -= transfer;
    }
}

void me_money_count(Person& person)                       // Выписка бюджета
{
    printf("Мой кошелек             : %d\n", person.money);
    printf("Мой банковский счет     : %d\n", person.bank_money);
}

void simulation(Person& person)
{
    for(year; year <= end_year; year++){          // Ежегодно

        for (month; month <= 12 ; month++){     // Ежемесячно
                if(year == end_year && month == end_month){
                    me_money_count(person); 
                    break;
                }
                me_salary(person); 

                me_shopping(person);

                me_cost_save(person, person.money);
        }
        month = 1;
    }
}

int main()
{
    simulation(I);
